{
  "openapi": "3.1.0",
  "info": {
    "title": "Eucast Mic Breakpoint Interpreter API",
    "description": "MIC categorisation requires user-verified EUCAST thresholds. Auxiliary audit endpoints are not clinical AST interpretations.",
    "version": "3.0.1",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "System optimal"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Prometheus operational metrics",
        "responses": {
          "200": {
            "description": "JSON counters and prototype system status"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Generic auxiliary threshold audit (not an EUCAST interpretation)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consensus dossier with HMAC signature"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Deterministic mock response (no clinical verification)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Retrieve and cryptographically verify HMAC audit trail",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          }
        }
      }
    },
    "/api/interpret": {
      "post": {
        "summary": "Interpret MIC using caller-supplied S/R breakpoints",
        "description": "No clinical breakpoint database is bundled. Result may be S, I, R, ATU, or UNDETERMINED.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "organism": {
                    "type": "string"
                  },
                  "antimicrobial": {
                    "type": "string"
                  },
                  "mic": {
                    "type": "string"
                  },
                  "s_le": {
                    "type": "string"
                  },
                  "r_gt": {
                    "type": "string"
                  },
                  "breakpoint_version": {
                    "type": "string"
                  },
                  "atu_low": {
                    "type": "string"
                  },
                  "atu_high": {
                    "type": "string"
                  }
                },
                "required": [
                  "organism",
                  "antimicrobial",
                  "mic",
                  "s_le",
                  "r_gt",
                  "breakpoint_version"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Categorisation and explanatory reason"
          },
          "422": {
            "description": "Invalid breakpoint or MIC input"
          }
        }
      }
    }
  }
}
